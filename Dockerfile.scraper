# Rodavia Scraper - Dockerfile para worker de scraping
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS base
WORKDIR /app

# Configurar usuario no-root para seguridad
RUN addgroup --system --gid 1001 scraper && \
    adduser --system --uid 1001 --ingroup scraper scraper
USER scraper

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

# Copiar archivos de proyecto y restaurar dependencias
COPY ["Rodavia.Scraper/Rodavia.Scraper.csproj", "Rodavia.Scraper/"]
COPY ["Rodavia.Infrastructure/Rodavia.Infrastructure.csproj", "Rodavia.Infrastructure/"]
COPY ["Rodavia.Core/Rodavia.Core.csproj", "Rodavia.Core/"]

RUN dotnet restore "Rodavia.Scraper/Rodavia.Scraper.csproj"

# Copiar código fuente
COPY . .
WORKDIR "/src/Rodavia.Scraper"

# Build de la aplicación
RUN dotnet build "Rodavia.Scraper.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "Rodavia.Scraper.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app

# Copiar archivos publicados
COPY --from=publish /app/publish .

# Labels para metadatos
LABEL maintainer="Rodavia Team" \
      version="1.0" \
      description="Rodavia Scraper - Worker de obtención de datos"

ENTRYPOINT ["dotnet", "Rodavia.Scraper.dll"]