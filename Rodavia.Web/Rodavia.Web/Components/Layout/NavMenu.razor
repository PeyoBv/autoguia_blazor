@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="fas fa-car-side me-2"></i>
            Rodavia
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="talleres">
                <i class="fas fa-wrench me-2" aria-hidden="true"></i> Talleres
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consumibles">
                <i class="fas fa-shopping-bag me-2" aria-hidden="true"></i> Productos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="foro">
                <i class="fas fa-comments me-2" aria-hidden="true"></i> Comunidad
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="diagnostico-asistente">
                <i class="fas fa-brain me-2" aria-hidden="true"></i> IA
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="suscripciones">
                <i class="fas fa-crown me-2" aria-hidden="true"></i> Planes
            </NavLink>
        </div>

        <div class="nav-item px-3" style="margin-top: auto; padding-top: 2rem;">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link" href="perfil">
                        <i class="fas fa-user-circle me-2" aria-hidden="true"></i> Mi Perfil
                    </NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <i class="fas fa-arrow-right-from-bracket me-2" aria-hidden="true"></i> Salir
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link btn-register" href="Account/Register">
                        <i class="fas fa-user-plus me-2" aria-hidden="true"></i> Registrarse
                    </NavLink>
                    <NavLink class="nav-link btn-login" href="Account/Login">
                        <i class="fas fa-sign-in-alt me-2" aria-hidden="true"></i> Iniciar Sesión
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

