@code {
    private int currentSlide = 0;
    private Timer autoPlayTimer;

    private List<CarouselCard> carouselCards = new()
    {
        new CarouselCard
        {
            Icon = "fas fa-car",
            Title = "Quiénes Somos",
            Description = "Rodavia es la plataforma líder en Chile y Latinoamérica para el sector automotriz. Conectamos a conductores con talleres certificados, ofrecemos herramientas de diagnóstico con IA y fomentamos una comunidad activa de entusiastas del motor.",
            Location = "Santiago, Chile 🇨🇱"
        },
        new CarouselCard
        {
            Icon = "fas fa-bullseye",
            Title = "Nuestra Misión",
            Description = "Democratizar el acceso a servicios automotrices de calidad mediante tecnología innovadora, proporcionando información transparente, comparación de precios en tiempo real y conectando a la comunidad automotriz con los mejores profesionales del sector.",
            Location = null
        },
        new CarouselCard
        {
            Icon = "fas fa-eye",
            Title = "Nuestra Visión",
            Description = "Ser la plataforma de referencia en Latinoamérica para el cuidado y mantenimiento vehicular, integrando inteligencia artificial, IoT y blockchain para crear un ecosistema automotriz digital, confiable y accesible para todos.",
            Location = null
        }
    };

    protected override void OnInitialized()
    {
        StartAutoPlay();
    }

    private void StartAutoPlay()
    {
        autoPlayTimer = new Timer(_ =>
        {
            NextSlide();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(7), TimeSpan.FromSeconds(7));
    }

    private void NextSlide()
    {
        currentSlide = (currentSlide + 1) % carouselCards.Count;
    }

    private void PreviousSlide()
    {
        currentSlide = (currentSlide - 1 + carouselCards.Count) % carouselCards.Count;
        ResetAutoPlay();
    }

    private void GoToSlide(int index)
    {
        currentSlide = index;
        ResetAutoPlay();
    }

    private void ResetAutoPlay()
    {
        autoPlayTimer?.Dispose();
        StartAutoPlay();
    }

    public void Dispose()
    {
        autoPlayTimer?.Dispose();
    }

    public class CarouselCard
    {
        public string Icon { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public string Location { get; set; }
    }
}
