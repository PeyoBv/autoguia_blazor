<!-- Sección About Us - Carrusel -->
<section class="about-carousel-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="h3 fw-bold text-dark mb-2">Conoce a Rodavia</h2>
                <p class="text-muted">Descubre nuestra misión, visión y propósito</p>
            </div>
        </div>

        <!-- Carousel Container - Mostrando 3 cards (actual + 2 siguientes) -->
        <div class="carousel-container mx-auto" style="max-width: 100%;">
            <div class="carousel-inner-multi">
                @for (int i = 0; i < 3; i++)
                {
                    int cardIndex = (currentSlide + i) % carouselCards.Count;
                    var card = carouselCards[cardIndex];
                    <div class="carousel-item-multi @(i == 0 ? "active" : "")">
                        <div class="about-card">
                            <div class="card-header-about">
                                <i class="@card.Icon"></i>
                                <h3>@card.Title</h3>
                            </div>
                            <div class="card-body-about">
                                @if (card.Location != null)
                                {
                                    <p class="card-location">
                                        <i class="fas fa-map-pin me-2"></i>@card.Location
                                    </p>
                                }
                                <p class="card-text">@card.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Navigation Controls -->
            <button class="carousel-btn prev" @onclick="PreviousSlide" aria-label="Anterior">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="carousel-btn next" @onclick="NextSlide" aria-label="Siguiente">
                <i class="fas fa-chevron-right"></i>
            </button>

            <!-- Dots Indicator -->
            <div class="carousel-dots mt-4">
                @foreach (var (index, _) in carouselCards.Select((c, i) => (i, c)))
                {
                    <button class="dot @(index == currentSlide ? "active" : "")" 
                            @onclick="() => GoToSlide(index)"
                            aria-label="Ir a slide @(index + 1)"></button>
                }
            </div>
        </div>
    </div>
</section>

<!-- CTA Final -->
<section class="cta-section py-5 bg-dark text-white">
