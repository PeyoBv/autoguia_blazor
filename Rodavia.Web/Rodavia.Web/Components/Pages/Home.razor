@page "/"
@rendermode InteractiveAuto

<PageTitle>AutoGuía - Tu plataforma automotriz integral</PageTitle>

<div class="hero-section bg-primary text-white py-5 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Bienvenido a AutoGuía</h1>
                <p class="lead mb-4">
                    Tu plataforma integral para el sector automotriz en Chile y Latinoamérica. 
                    Encuentra talleres confiables, resuelve tus dudas en nuestra comunidad y 
                    accede a información técnica especializada.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/consumibles" class="btn btn-warning btn-lg">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Ver Productos
                    </a>
                    <a href="/talleres" class="btn btn-light btn-lg">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Buscar Talleres
                    </a>
                    <a href="/foro" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-comments me-2"></i>
                        Únete al Foro
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="car-animation">
                    <svg viewBox="0 0 200 120" class="car-svg" xmlns="http://www.w3.org/2000/svg">
                        <!-- Cuerpo del auto -->
                        <rect x="30" y="60" width="140" height="40" rx="10" fill="#ffffff" opacity="0.9"/>
                        
                        <!-- Ventanas -->
                        <path d="M60 60 L80 40 L120 40 L140 60 Z" fill="#007bff" opacity="0.7"/>
                        
                        <!-- Ruedas -->
                        <circle cx="60" cy="100" r="15" fill="#333" stroke="#ffffff" stroke-width="3"/>
                        <circle cx="60" cy="100" r="8" fill="#666"/>
                        <circle cx="140" cy="100" r="15" fill="#333" stroke="#ffffff" stroke-width="3"/>
                        <circle cx="140" cy="100" r="8" fill="#666"/>
                        
                        <!-- Faros -->
                        <ellipse cx="165" cy="70" rx="5" ry="8" fill="#ffeb3b"/>
                        <ellipse cx="35" cy="70" rx="5" ry="8" fill="#ffeb3b"/>
                        
                        <!-- Líneas de velocidad -->
                        <line x1="5" y1="50" x2="20" y2="50" stroke="#ffffff" stroke-width="2" opacity="0.6" stroke-linecap="round"/>
                        <line x1="10" y1="65" x2="25" y2="65" stroke="#ffffff" stroke-width="2" opacity="0.6" stroke-linecap="round"/>
                        <line x1="5" y1="80" x2="20" y2="80" stroke="#ffffff" stroke-width="2" opacity="0.6" stroke-linecap="round"/>
                    </svg>
                    <div class="car-label">
                        <i class="fas fa-tools me-2"></i>
                        <span>Tu mecánico de confianza</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-primary bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center">
                        <i class="fas fa-map-marked-alt fa-2x"></i>
                    </div>
                    <h3 class="card-title h4">Mapa de Talleres</h3>
                    <p class="card-text">
                        Encuentra talleres mecánicos confiables cerca de ti. 
                        Revisa calificaciones, especialidades y horarios de atención.
                    </p>
                    <a href="/talleres" class="btn btn-primary">Explorar Talleres</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-success bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h3 class="card-title h4">Foro Comunitario</h3>
                    <p class="card-text">
                        Conecta con otros entusiastas del motor. 
                        Comparte experiencias, resuelve dudas y aprende de expertos.
                    </p>
                    <a href="/foro" class="btn btn-success">Ver Discusiones</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-info bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center">
                        <i class="fas fa-robot fa-2x"></i>
                    </div>
                    <h3 class="card-title h4">Diagnóstico IA</h3>
                    <p class="card-text">
                        Obtén diagnósticos instantáneos con inteligencia artificial. 
                        Describe la falla y recibe posibles causas y soluciones.
                    </p>
                    <a href="/diagnostico-asistente" class="btn btn-info">Diagnosticar</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon bg-warning bg-gradient text-white rounded-3 mb-3 d-inline-flex align-items-center justify-content-center">
                        <i class="fas fa-shopping-cart fa-2x"></i>
                    </div>
                    <h3 class="card-title h4">Catálogo de Productos</h3>
                    <p class="card-text">
                        Explora productos automotrices de calidad. 
                        Encuentra repuestos, accesorios y consumibles para tu vehículo.
                    </p>
                    <a href="/consumibles" class="btn btn-warning">Ver Productos</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto text-center">
            <h2 class="mb-4">¿Por qué elegir AutoGuía?</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <i class="fas fa-shield-alt fa-2x text-primary"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5>Talleres Verificados</h5>
                            <p class="mb-0">Solo trabajamos con talleres que han pasado nuestro proceso de verificación.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <i class="fas fa-star fa-2x text-warning"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5>Reseñas Reales</h5>
                            <p class="mb-0">Calificaciones y comentarios de usuarios reales de la comunidad.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x text-success"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5>Disponible 24/7</h5>
                            <p class="mb-0">Accede a la información cuando la necesites, cualquier día del año.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <i class="fas fa-mobile-alt fa-2x text-info"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5>Móvil y Web</h5>
                            <p class="mb-0">Optimizado para funcionar perfectamente en todos tus dispositivos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #007bff, #0056b3);
    }
    
    .feature-icon {
        width: 4rem;
        height: 4rem;
    }
    
    .fa-10x {
        font-size: 8em;
    }
    
    .car-animation {
        animation: float 3s ease-in-out infinite;
        position: relative;
    }
    
    .car-svg {
        width: 100%;
        max-width: 400px;
        height: auto;
        filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
    }
    
    .car-label {
        margin-top: 1.5rem;
        font-size: 1.2rem;
        font-weight: 600;
        color: white;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }
</style>
