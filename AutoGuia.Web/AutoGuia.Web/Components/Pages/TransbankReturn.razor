@page "/pagos/transbank/retorno"
@rendermode InteractiveServer
@using AutoGuia.Core.DTOs
@using AutoGuia.Infrastructure.Services.Payments
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject ITransbankGateway TransbankGateway
@inject NavigationManager Navigation
@inject ILogger<TransbankReturn> Logger

<PageTitle>Procesando Pago - AutoGuía</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    @if (isProcessing)
                    {
                        <!-- Estado: Procesando -->
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Procesando...</span>
                        </div>
                        <h3 class="mb-3">Procesando tu pago...</h3>
                        <p class="text-muted">Por favor espera mientras confirmamos tu transacción con Transbank.</p>
                        <div class="progress mt-4" style="height: 4px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                        </div>
                    }
                    else if (isSuccess)
                    {
                        <!-- Estado: Éxito -->
                        <div class="text-success mb-4">
                            <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="text-success mb-3">¡Pago Confirmado!</h3>
                        <p class="mb-2">Tu tarjeta ha sido inscrita exitosamente.</p>
                        
                        @if (resultado != null)
                        {
                            <div class="alert alert-success mt-4" role="alert">
                                <div class="row">
                                    <div class="col-md-6 text-start">
                                        <strong>Tarjeta:</strong> @resultado.CardType ****@resultado.Last4Digits
                                    </div>
                                    <div class="col-md-6 text-start">
                                        <strong>Autorización:</strong> @resultado.AuthorizationCode
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary btn-lg" @onclick="IrAMediosPago">
                                <i class="bi bi-credit-card me-2"></i>Ver Medios de Pago
                            </button>
                        </div>
                        
                        <p class="text-muted mt-3 small">
                            Serás redirigido automáticamente en <strong>@countdown</strong> segundos...
                        </p>
                    }
                    else if (isError)
                    {
                        <!-- Estado: Error -->
                        <div class="text-danger mb-4">
                            <i class="bi bi-x-circle-fill" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="text-danger mb-3">Error al Procesar el Pago</h3>
                        <p class="mb-4">@errorMessage</p>
                        
                        <div class="alert alert-danger" role="alert">
                            <strong>¿Qué puedes hacer?</strong>
                            <ul class="text-start mt-2 mb-0">
                                <li>Verifica que tu tarjeta tenga fondos suficientes</li>
                                <li>Asegúrate de que la tarjeta esté habilitada para compras por internet</li>
                                <li>Intenta con otra tarjeta de crédito o débito</li>
                                <li>Contacta a tu banco si el problema persiste</li>
                            </ul>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary me-2" @onclick="Reintentar">
                                <i class="bi bi-arrow-clockwise me-2"></i>Reintentar
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="VolverASuscripciones">
                                <i class="bi bi-arrow-left me-2"></i>Volver a Suscripciones
                            </button>
                        </div>
                    }
                </div>
            </div>

            @if (!isProcessing)
            {
                <!-- Información Adicional -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-info-circle me-2"></i>Información de la Transacción
                        </h6>
                        <div class="row small text-muted">
                            <div class="col-md-6">
                                <strong>Token:</strong> @(token ?? "N/A")
                            </div>
                            <div class="col-md-6">
                                <strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token_ws")]
    public string? TokenWs { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "TBK_TOKEN")]
    public string? TbkToken { get; set; }

    [SupplyParameterFromQuery(Name = "TBK_ORDEN_COMPRA")]
    public string? TbkOrdenCompra { get; set; }

    [SupplyParameterFromQuery(Name = "TBK_ID_SESION")]
    public string? TbkIdSesion { get; set; }

    private bool isProcessing = true;
    private bool isSuccess = false;
    private bool isError = false;
    private string? errorMessage;
    private string? token;
    private int countdown = 5;
    private ConfirmarInscripcionResponseDto? resultado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Determinar el token recibido (Transbank puede usar diferentes nombres)
            token = TokenWs ?? Token ?? TbkToken;

            // Si viene TBK_ORDEN_COMPRA y TBK_ID_SESION, significa que hubo rechazo/anulación
            if (!string.IsNullOrEmpty(TbkOrdenCompra) && !string.IsNullOrEmpty(TbkIdSesion))
            {
                Logger.LogWarning("Transacción rechazada o anulada por Transbank. OrdenCompra: {OrdenCompra}, IdSesion: {IdSesion}", 
                    TbkOrdenCompra, TbkIdSesion);
                MostrarError("La transacción fue rechazada por Transbank o fue cancelada por el usuario. Por favor, verifica los datos de tu tarjeta e intenta nuevamente.");
                return;
            }

            if (string.IsNullOrEmpty(token))
            {
                Logger.LogWarning("No se recibió token en el retorno de Transbank");
                MostrarError("No se recibió información de la transacción. Por favor, intenta nuevamente.");
                return;
            }

            Logger.LogInformation("Procesando retorno de Transbank con token: {Token}", token);

            // Llamar al servicio para confirmar la inscripción
            resultado = await TransbankGateway.ConfirmarInscripcionAsync(token);

            if (resultado.Success)
            {
                Logger.LogInformation("Inscripción confirmada exitosamente. PaymentMethodId: {PaymentMethodId}", 
                    resultado.PaymentMethodId);
                
                isSuccess = true;
                isProcessing = false;

                // Iniciar contador regresivo para redirección automática
                _ = IniciarContadorRegresivo();
            }
            else
            {
                Logger.LogWarning("Error al confirmar inscripción: {Error}", resultado.ErrorMessage);
                MostrarError(resultado.ErrorMessage ?? "Error desconocido al procesar la transacción.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Excepción al procesar retorno de Transbank");
            MostrarError("Ocurrió un error inesperado al procesar tu pago. Por favor, contacta a soporte.");
        }
    }

    private void MostrarError(string mensaje)
    {
        isError = true;
        isProcessing = false;
        isSuccess = false;
        errorMessage = mensaje;
    }

    private async Task IniciarContadorRegresivo()
    {
        for (int i = countdown; i > 0; i--)
        {
            countdown = i;
            StateHasChanged();
            await Task.Delay(1000);
        }

        IrAMediosPago();
    }

    private void IrAMediosPago()
    {
        Navigation.NavigateTo("/perfil/medios-pago");
    }

    private void VolverASuscripciones()
    {
        Navigation.NavigateTo("/suscripciones", forceLoad: true);
    }

    private void Reintentar()
    {
        Navigation.NavigateTo("/suscripciones", forceLoad: true);
    }
}
