@page "/cuenta/medios-pago"
@rendermode InteractiveServer
@using AutoGuia.Core.DTOs
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Medios de Pago - AutoGuía</PageTitle>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-credit-card me-2"></i> Mis Medios de Pago</h2>
                <button class="btn btn-primary" @onclick="IniciarInscripcionWebpay" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="fab fa-cc-visa me-2"></i>
                        <span>Pagar con Webpay</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                    <i class="fas @(esError ? "fa-exclamation-circle" : "fa-check-circle") me-2"></i>
                    @mensaje
                    <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
                </div>
            }

            @if (cargandoLista)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3 text-muted">Cargando medios de pago...</p>
                </div>
            }
            else if (mediosPago == null || !mediosPago.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-credit-card fa-4x text-muted mb-3"></i>
                        <h5>No tienes medios de pago registrados</h5>
                        <p class="text-muted">Inscribe una tarjeta con Webpay para activar suscripciones de pago</p>
                        <button class="btn btn-primary btn-lg mt-3" @onclick="IniciarInscripcionWebpay" disabled="@cargando">
                            @if (cargando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Procesando...</span>
                            }
                            else
                            {
                                <i class="fab fa-cc-visa me-2"></i>
                                <span>Inscribir con Webpay</span>
                            }
                        </button>
                        <p class="text-muted small mt-3">
                            <i class="fas fa-shield-alt me-1"></i>
                            Proceso seguro con Transbank
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var medio in mediosPago)
                    {
                        <div class="col-12">
                            <div class="card border-0 shadow-sm @(medio.IsDefault ? "border-primary" : "")">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <div class="avatar-lg bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="fas @ObtenerIconoTarjeta(medio.CardType) fa-2x text-primary"></i>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="d-flex align-items-center mb-1">
                                                <h5 class="mb-0 me-2">@medio.CardType</h5>
                                                @if (medio.IsDefault)
                                                {
                                                    <span class="badge bg-primary">Predeterminada</span>
                                                }
                                            </div>
                                            <p class="text-muted mb-1">@medio.CardMask</p>
                                            <small class="text-muted">
                                                Agregada el @medio.InscriptionDate.ToString("dd/MM/yyyy")
                                            </small>
                                        </div>
                                        <div class="col-auto">
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    @if (!medio.IsDefault)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item" @onclick="() => EstablecerPredeterminada(medio.Id)">
                                                                <i class="fas fa-star me-2"></i> Establecer como predeterminada
                                                            </button>
                                                        </li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <button class="dropdown-item text-danger" @onclick="() => ConfirmarEliminacion(medio)">
                                                            <i class="fas fa-trash me-2"></i> Eliminar
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6><i class="fas fa-shield-alt me-2"></i> Seguridad</h6>
                    <p class="text-muted small mb-0">
                        Tus datos de pago están protegidos por Transbank. AutoGuía no almacena 
                        números completos de tarjetas ni códigos de seguridad.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PaymentMethodDto>? mediosPago;
    private bool cargando = false;
    private bool cargandoLista = true;
    private string mensaje = string.Empty;
    private bool esError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarMediosPago();
    }

    private async Task CargarMediosPago()
    {
        try
        {
            cargandoLista = true;
            mediosPago = await Http.GetFromJsonAsync<List<PaymentMethodDto>>("/api/payments/medios-pago");
        }
        catch (Exception ex)
        {
            MostrarError($"Error al cargar medios de pago: {ex.Message}");
        }
        finally
        {
            cargandoLista = false;
        }
    }

    /// <summary>
    /// Inicia el flujo de inscripción OneClick con Transbank Webpay
    /// </summary>
    private async Task IniciarInscripcionWebpay()
    {
        try
        {
            cargando = true;
            MostrarExito("Preparando inscripción con Transbank...");

            // Construir URL de retorno absoluta
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var returnUrl = $"{baseUrl}/pagos/transbank/retorno";

            // Crear request con los datos del usuario
            var request = new IniciarInscripcionRequestDto
            {
                Email = "usuario@autoguia.cl", // TODO: Obtener del contexto de usuario
                Username = "usuario",           // TODO: Obtener del contexto de usuario
                ReturnUrl = returnUrl
            };

            // Llamar al endpoint POST /api/payments/inscripcion/iniciar
            var response = await Http.PostAsJsonAsync("/api/payments/inscripcion/iniciar", request);
            
            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<IniciarInscripcionResponseDto>();
                
                if (resultado?.Success == true && !string.IsNullOrEmpty(resultado.UrlWebpay))
                {
                    MostrarExito("Redirigiendo a Transbank Webpay...");
                    
                    // Pequeño delay para que el usuario vea el mensaje
                    await Task.Delay(500);
                    
                    // Redirigir al usuario a la URL de Webpay
                    Navigation.NavigateTo(resultado.UrlWebpay, forceLoad: true);
                }
                else
                {
                    MostrarError(resultado?.ErrorMessage ?? "Error al iniciar inscripción con Webpay");
                    cargando = false;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                MostrarError($"Error al comunicarse con el servidor: {response.StatusCode}");
                cargando = false;
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al iniciar inscripción: {ex.Message}");
            cargando = false;
        }
    }

    private async Task EstablecerPredeterminada(int id)
    {
        try
        {
            var response = await Http.PutAsync($"/api/payments/medios-pago/{id}/predeterminado", null);
            
            if (response.IsSuccessStatusCode)
            {
                MostrarExito("Medio de pago establecido como predeterminado");
                await CargarMediosPago();
            }
            else
            {
                MostrarError("Error al establecer medio de pago predeterminado");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }

    private async Task ConfirmarEliminacion(PaymentMethodDto medio)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", 
            $"¿Está seguro que desea eliminar la tarjeta terminada en {medio.Last4Digits}?");

        if (confirmar)
        {
            await EliminarMedioPago(medio.Id);
        }
    }

    private async Task EliminarMedioPago(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/payments/medios-pago/{id}");
            
            if (response.IsSuccessStatusCode)
            {
                MostrarExito("Medio de pago eliminado exitosamente");
                await CargarMediosPago();
            }
            else
            {
                MostrarError("Error al eliminar medio de pago");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }

    private void MostrarExito(string msg)
    {
        mensaje = msg;
        esError = false;
    }

    private void MostrarError(string msg)
    {
        mensaje = msg;
        esError = true;
    }

    private string ObtenerIconoTarjeta(string? tipo)
    {
        return tipo?.ToLower() switch
        {
            "visa" => "fa-cc-visa",
            "mastercard" => "fa-cc-mastercard",
            "amex" or "american express" => "fa-cc-amex",
            _ => "fa-credit-card"
        };
    }
}

<style>
    .avatar-lg {
        width: 64px;
        height: 64px;
    }
</style>
