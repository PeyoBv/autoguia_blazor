@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<header class="site-header" role="banner">
  <nav class="navbar navbar-expand-lg navbar-light bg-white" role="navigation" aria-label="Navegación principal">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/" aria-label="AutoGuía - Ir a página de inicio">
        <img src="/images/logo-autoguia-horizontal.svg" alt="" role="presentation" height="40" />
        <span class="visually-hidden">AutoGuía - Tu Plataforma Automotriz</span>
      </a>

      <button 
        class="navbar-toggler" 
        type="button" 
        @onclick="ToggleMobileMenu"
        @onclick:stopPropagation="true"
        aria-controls="mainNav"
        aria-expanded="@mobileMenuOpen"
        aria-label="@(mobileMenuOpen ? "Cerrar menú de navegación" : "Abrir menú de navegación")">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
      </button>

      <div class="@GetNavbarCollapseClass()" id="mainNav" @onclick:stopPropagation="true">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0" role="menubar" aria-label="Menú principal">
          <li class="nav-item" role="none">
            <a class="nav-link" href="/" role="menuitem" @onclick="CloseMobileMenu">
              Inicio
            </a>
          </li>

          <li class="nav-item" role="none">
            <a class="nav-link" href="/repuestos" role="menuitem" @onclick="CloseMobileMenu">
              <i class="bi bi-gear-fill me-1" aria-hidden="true"></i> Repuestos
            </a>
          </li>

          <li class="nav-item" role="none">
            <a class="nav-link" href="/talleres" role="menuitem" @onclick="CloseMobileMenu">
              <i class="bi bi-tools me-1" aria-hidden="true"></i> Talleres
            </a>
          </li>

          <li class="nav-item dropdown" role="none" @onkeydown="HandleDropdownKeyDown">
            <button 
              class="nav-link dropdown-toggle btn btn-link" 
              type="button"
              id="servicesDropdown"
              @onclick="ToggleServicesDropdown"
              @onclick:stopPropagation="true"
              aria-expanded="@servicesDropdownOpen"
              aria-controls="servicesDropdownMenu"
              aria-haspopup="true"
              aria-label="Menú de servicios">
              <i class="bi bi-wrench me-1" aria-hidden="true"></i> Servicios
            </button>
            
            <div 
              class="@GetDropdownMenuClass()" 
              id="servicesDropdownMenu"
              role="menu"
              aria-labelledby="servicesDropdown"
              @onclick:stopPropagation="true">
              <div class="row">
                <div class="col-6 col-md-3">
                  <h6 class="menu-title" id="diagnostico-heading" role="presentation">
                    <span aria-hidden="true">🔍</span> Diagnóstico
                  </h6>
                  <a class="dropdown-item" href="/consulta-vehiculo" role="menuitem" @onclick="CloseAllMenus" aria-describedby="diagnostico-heading">
                    Consulta VIN
                  </a>
                  <a class="dropdown-item" href="/diagnostico-ia" role="menuitem" @onclick="CloseAllMenus" aria-describedby="diagnostico-heading">
                    Asistente IA
                  </a>
                </div>
                
                <div class="col-6 col-md-3">
                  <h6 class="menu-title" id="comunidad-heading" role="presentation">
                    <span aria-hidden="true">💬</span> Comunidad
                  </h6>
                  <a class="dropdown-item" href="/foro" role="menuitem" @onclick="CloseAllMenus" aria-describedby="comunidad-heading">
                    Foro Automotriz
                  </a>
                  <a class="dropdown-item" href="/experiencias" role="menuitem" @onclick="CloseAllMenus" aria-describedby="comunidad-heading">
                    Experiencias
                  </a>
                </div>
                
                <div class="col-6 col-md-3">
                  <h6 class="menu-title" id="premium-heading" role="presentation">
                    <span aria-hidden="true">💎</span> Premium
                  </h6>
                  <a class="dropdown-item" href="/suscripciones" role="menuitem" @onclick="CloseAllMenus" aria-describedby="premium-heading">
                    Planes
                  </a>
                  <a class="dropdown-item" href="/beneficios" role="menuitem" @onclick="CloseAllMenus" aria-describedby="premium-heading">
                    Beneficios
                  </a>
                </div>
                
                <div class="col-6 col-md-3">
                  <h6 class="menu-title" id="recursos-heading" role="presentation">
                    <span aria-hidden="true">📚</span> Recursos
                  </h6>
                  <a class="dropdown-item" href="/about" role="menuitem" @onclick="CloseAllMenus" aria-describedby="recursos-heading">
                    Acerca de
                  </a>
                  <a class="dropdown-item" href="/soporte" role="menuitem" @onclick="CloseAllMenus" aria-describedby="recursos-heading">
                    Soporte
                  </a>
                </div>
              </div>
            </div>
          </li>
        </ul>

        <form class="d-flex me-3" @onsubmit="HandleSearchSubmit" @onsubmit:preventDefault="true" role="search" aria-label="Buscar en el sitio">
          <label for="siteSearch" class="visually-hidden">Buscar productos, talleres o información</label>
          <input 
            id="siteSearch" 
            class="form-control" 
            type="search" 
            placeholder="Buscar" 
            aria-label="Término de búsqueda"
            @bind="searchQuery"
            @bind:event="oninput"
            @onkeydown="HandleSearchKeyDown" />
        </form>

        <div class="d-flex align-items-center gap-2">
          <a class="btn btn-link" href="/Account/Login" @onclick="CloseMobileMenu" aria-label="Iniciar sesión en tu cuenta">
            <i class="bi bi-person-circle me-1" aria-hidden="true"></i> 
            <span>Iniciar sesión</span>
          </a>
          <a class="btn btn-primary" href="/suscripciones" @onclick="CloseMobileMenu" aria-label="Explorar planes premium de AutoGuía">
            <i class="bi bi-star-fill me-1" aria-hidden="true"></i> 
            <span>Premium</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

@code {
  private bool mobileMenuOpen = false;
  private bool servicesDropdownOpen = false;
  private string searchQuery = string.Empty;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await JSRuntime.InvokeVoidAsync("initializeHeaderAccessibility");
    }
  }

  private void ToggleMobileMenu()
  {
    mobileMenuOpen = !mobileMenuOpen;
    if (mobileMenuOpen)
    {
      servicesDropdownOpen = false;
    }
  }

  private void CloseMobileMenu()
  {
    mobileMenuOpen = false;
    servicesDropdownOpen = false;
  }

  private void ToggleServicesDropdown()
  {
    servicesDropdownOpen = !servicesDropdownOpen;
  }

  private void CloseAllMenus()
  {
    mobileMenuOpen = false;
    servicesDropdownOpen = false;
  }

  private string GetNavbarCollapseClass()
  {
    return mobileMenuOpen ? "collapse navbar-collapse show" : "collapse navbar-collapse";
  }

  private string GetDropdownMenuClass()
  {
    return servicesDropdownOpen ? "dropdown-menu mega-menu p-4 show" : "dropdown-menu mega-menu p-4";
  }

  private async Task HandleDropdownKeyDown(KeyboardEventArgs e)
  {
    switch (e.Key)
    {
      case "Escape":
        servicesDropdownOpen = false;
        await JSRuntime.InvokeVoidAsync("focusElement", "servicesDropdown");
        break;
      case "ArrowDown":
        if (!servicesDropdownOpen)
        {
          servicesDropdownOpen = true;
        }
        await JSRuntime.InvokeVoidAsync("focusFirstDropdownItem", "servicesDropdownMenu");
        break;
      case "ArrowUp":
        await JSRuntime.InvokeVoidAsync("focusLastDropdownItem", "servicesDropdownMenu");
        break;
    }
  }

  private async Task HandleSearchKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Escape")
    {
      searchQuery = string.Empty;
      await JSRuntime.InvokeVoidAsync("blurElement", "siteSearch");
    }
  }

  private void HandleSearchSubmit()
  {
    if (!string.IsNullOrWhiteSpace(searchQuery))
    {
      // TODO: Implementar lógica de búsqueda
      Console.WriteLine($"Búsqueda: {searchQuery}");
    }
  }
}

<script>
  window.initializeHeaderAccessibility = function() {
    // Close dropdowns and mobile menu when clicking outside
    document.addEventListener('click', function(event) {
      const navbar = document.getElementById('mainNav');
      const toggler = document.querySelector('.navbar-toggler');
      const dropdown = document.getElementById('servicesDropdownMenu');
      
      if (navbar && !navbar.contains(event.target) && !toggler.contains(event.target)) {
        // Trigger Blazor to close menus
        const closeEvent = new CustomEvent('blazor:closemenus');
        document.dispatchEvent(closeEvent);
      }
    });

    // Keyboard navigation for dropdown items
    document.addEventListener('keydown', function(event) {
      const dropdown = document.getElementById('servicesDropdownMenu');
      if (!dropdown || !dropdown.classList.contains('show')) return;

      const items = dropdown.querySelectorAll('.dropdown-item');
      const currentIndex = Array.from(items).findIndex(item => item === document.activeElement);

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        const nextIndex = (currentIndex + 1) % items.length;
        items[nextIndex]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        const prevIndex = currentIndex <= 0 ? items.length - 1 : currentIndex - 1;
        items[prevIndex]?.focus();
      } else if (event.key === 'Home') {
        event.preventDefault();
        items[0]?.focus();
      } else if (event.key === 'End') {
        event.preventDefault();
        items[items.length - 1]?.focus();
      } else if (event.key === 'Tab') {
        // Allow natural tab behavior
        if (!event.shiftKey && currentIndex === items.length - 1) {
          // Close dropdown when tabbing out
          const closeEvent = new CustomEvent('blazor:closemenus');
          document.dispatchEvent(closeEvent);
        }
      }
    });
  };

  window.focusElement = function(elementId) {
    const element = document.getElementById(elementId);
    if (element) element.focus();
  };

  window.blurElement = function(elementId) {
    const element = document.getElementById(elementId);
    if (element) element.blur();
  };

  window.focusFirstDropdownItem = function(dropdownId) {
    const dropdown = document.getElementById(dropdownId);
    if (dropdown) {
      const firstItem = dropdown.querySelector('.dropdown-item');
      if (firstItem) firstItem.focus();
    }
  };

  window.focusLastDropdownItem = function(dropdownId) {
    const dropdown = document.getElementById(dropdownId);
    if (dropdown) {
      const items = dropdown.querySelectorAll('.dropdown-item');
      if (items.length > 0) items[items.length - 1].focus();
    }
  };
</script>

<style>
  /* Accessibility Enhancements */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Focus styles for keyboard navigation */
  .nav-link:focus-visible,
  .dropdown-item:focus-visible,
  .navbar-toggler:focus-visible {
    outline: 3px solid var(--color-primary, #0d6efd);
    outline-offset: 2px;
    border-radius: var(--radius-sm, 0.25rem);
  }

  /* Dropdown button styling */
  .dropdown-toggle.btn-link {
    background: none;
    border: none;
    padding: var(--spacing-sm, 0.5rem) var(--spacing-md, 1rem);
    color: var(--color-text, #212529);
    text-decoration: none;
    cursor: pointer;
  }

  .dropdown-toggle.btn-link:hover {
    background-color: var(--color-bg-secondary, #f8f9fa);
    color: var(--color-primary, #0d6efd);
  }

  /* Skip to main content link (add to layout if needed) */
  .skip-to-main {
    position: absolute;
    left: -9999px;
    z-index: 999;
    padding: var(--spacing-sm, 0.5rem) var(--spacing-md, 1rem);
    background-color: var(--color-primary, #0d6efd);
    color: white;
    text-decoration: none;
  }

  .skip-to-main:focus {
    left: 0;
    top: 0;
  }

  /* High contrast mode support */
  @@media (prefers-contrast: high) {
    .nav-link:focus-visible,
    .dropdown-item:focus-visible,
    .navbar-toggler:focus-visible {
      outline-width: 4px;
    }
  }
</style>